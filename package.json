{
  "name": "pandas-drills",
  "version": "0.1.0",
  "private": true,
  "description": "pandas exercises that run and grade themselves in the browser with Pyodide",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "bundle": "node scripts/build-bundle.ts",
    "dev": "npm run bundle && vite",
    "build": "npm run bundle && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/smoke.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.15",
    "codemirror": "6.0.2"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "playwright": "1.65.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
